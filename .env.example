APP_NAME="Oil India Digital Twin for Well-to-Surface Optimization"
FIELD_NAME="Oil India Limited - Baghewala Asset"

# Database Configuration (Default SQLite for local dev, or PostgreSQL for production)
DATABASE_URL="sqlite:///./digital_twin.db"
# DATABASE_URL="postgresql://oil_user:oil_password@localhost:5432/digital_twin"

# Model & Data Paths
MODEL_DIR="models"
TRAIN_DATA_PATH="data/mock_sensor_data.csv"
ANOMALY_MODEL_PATH="models/isolation_forest.joblib"
REGRESSOR_MODEL_PATH="models/random_forest_regressor.joblib"
SHAP_BACKGROUND_PATH="models/shap_background.joblib"

# API & Streaming Configuration
API_BASE_URL="http://127.0.0.1:8000"
SIMULATOR_INTERVAL_SECONDS=3.0
